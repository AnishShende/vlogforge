# Copy to .env (repo root) and fill in. .env is git-ignored.

# Anthropic API key: edit passes, story plan and post copy all call Claude.
CLAUDE_API_KEY=

# Postgres (docker-compose.yml starts one with these credentials).
DATABASE_URL=postgresql+asyncpg://vlogforge:vlogforge_password@localhost:5432/vlogforge_db

# Signs login tokens. Set a long random value anywhere other than your own machine.
JWT_SECRET_KEY=change-me

# Optional steps (defaults shown).
ENABLE_STORY_PLAN=true        # reorder moments and fit the target duration
ENABLE_MOMENTS=true           # story plan off: still build the moment table
ENABLE_FORCED_ALIGNMENT=true  # WhisperX word timings
ENABLE_BACKGROUND_POST_COPY=true
ENABLE_BROLL=false            # B-roll over voice-over: not in the MVP
